# Wails build output. The app icon lives here by convention and is source, not
# output: without it Wails regenerates its own default logo on a fresh clone.
build/*
!build/appicon.png

# JavaScript dependencies and generated frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Local environment and editor files
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
*.log
/sonara
__pycache__/

/docs
